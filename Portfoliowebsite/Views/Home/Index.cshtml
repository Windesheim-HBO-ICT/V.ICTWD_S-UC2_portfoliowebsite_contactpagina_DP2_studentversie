@{ ViewData["Title"] = "Profiel"; }

<section class="profile-hero">
    <div>
        <p class="eyebrow">Software engineering student</p>
        <h1>Hoi, ik ben Sam de Vries.</h1>
        <p class="hero-copy">Ik bouw toegankelijke webapplicaties waarin techniek begrijpelijk blijft voor de mensen die ermee werken.</p>
        <div class="hero-actions">
            <a class="button-primary" asp-controller="Contact" asp-action="Index">Neem contact op</a>
            <a class="text-link" href="#projects">Bekijk mijn projecten</a>
        </div>
    </div>
    <div class="profile-mark" aria-hidden="true">SD</div>
</section>

<div class="profile-grid">
    <main class="profile-main">
        <section aria-labelledby="about-title">
            <h2 id="about-title">Over mij</h2>
            <p>Ik ben tweedejaars HBO-ICT-student in Zwolle. Mijn interesse ligt bij webdevelopment, softwarearchitectuur en digitale toegankelijkheid. In projecten werk ik graag iteratief: eerst begrijpen wat iemand nodig heeft, daarna gericht bouwen en testen.</p>
        </section>
        <section id="projects" aria-labelledby="projects-title">
            <h2 id="projects-title">Uitgelichte projecten</h2>
            <div class="project-list">
                <article class="project-card">
                    <p class="project-type">ASP.NET MVC</p>
                    <h3>Optistyle platform</h3>
                    <p>Een modulair webplatform voor een lokale opticien, met aandacht voor toegankelijke formulieren en veilige verwerking van invoer.</p>
                    <ul class="tag-list" aria-label="Gebruikte technieken"><li>C#</li><li>Razor</li><li>HTML</li><li>CSS</li></ul>
                </article>
                <article class="project-card">
                    <p class="project-type">C#</p>

                    <h4>Reserveringssysteem</h4>
                    <p>Een objectgeoriënteerde applicatie voor het plannen en beheren van reserveringen.</p>
                    <ul class="tag-list" aria-label="Gebruikte technieken"><li>C#</li><li>OOP</li><li>Unit tests</li></ul>
                </article>
            </div>
        </section>
        <section aria-labelledby="experience-title">
            <h2 id="experience-title">Ervaring</h2>
            <ol class="timeline">
                <li><span>2025 - nu</span><strong>HBO-ICT</strong><p>Software Engineering, Windesheim</p></li>
                <li><span>2024 - 2025</span><strong>Junior developer</strong><p>Vrijwilligersproject voor een sportvereniging</p></li>
            </ol>
        </section>
    </main>
    <aside class="profile-sidebar" aria-labelledby="skills-title">
        <h2 id="skills-title">Vaardigheden</h2>
        <ul class="skill-list">
            <li><span>HTML en CSS</span><span>Gevorderd</span></li>
            <li><span>C# en ASP.NET</span><span>Gevorderd</span></li>
            <li><span>JavaScript</span><span>Basis</span></li>
            <li><span>Git</span><span>Gevorderd</span></li>
        </ul>
        <h2>Talen</h2>
        <p>Nederlands · moedertaal<br />Engels · professioneel</p>
    </aside>
</div>
